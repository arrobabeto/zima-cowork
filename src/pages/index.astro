---
import Base from "~/layouts/Base.astro"
import Seo from "~/components/seo/Seo.astro"
import SectionZimaHome from "~/components/sections/SectionZimaHome.astro"
import type { SeoData } from "~/lib/seo"

const locale = "en" as const
const title = "ZIMA Coffee + Cowork | Cowork en San Luis Potosí"
const description =
  "Cowork, cafetería, sala de juntas y estudio profesional de podcast en Lomas 4ta Sección, San Luis Potosí."
const canonical = Astro.url.href
const ogImage = new URL(
  "/images/zima/hero-home-zima-real.jpg",
  Astro.url.origin,
).href
const seo: SeoData = {
  title,
  description,
  keywords: [
    "cowork San Luis Potosí",
    "sala de juntas",
    "estudio de podcast",
    "cafetería",
  ],
  canonical,
  alternates: [
    { hreflang: "es", href: canonical },
    { hreflang: "x-default", href: canonical },
  ],
  ogTitle: title,
  ogDescription: description,
  ogImage,
  ogType: "website",
  twitterCard: "summary_large_image",
  twitterSite: "",
  twitterCreator: "",
  jsonLd: {},
}
---

<Base
  locale={locale}
  htmlLang="es"
  chrome={false}
  bodyClass="bg-zima-canvas text-zima-ink"
>
  <Fragment slot="head">
    <Seo {...seo} />
  </Fragment>
  <SectionZimaHome locale={locale} />
</Base>
