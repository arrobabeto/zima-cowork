---
import Base from "~/layouts/Base.astro"
import Seo from "~/components/seo/Seo.astro"
import SectionZimaPodcast from "~/components/sections/SectionZimaPodcast.astro"
import type { SeoData } from "~/lib/seo"

const locale = "en" as const
const title = "Estudio de podcast | ZIMA Coffee + Cowork"
const description =
  "Graba podcasts, entrevistas y contenido profesional en el estudio equipado de ZIMA en San Luis Potosí."
const canonical = Astro.url.href
const ogImage = new URL("/images/zima/podcast-hero.png", Astro.url.origin).href
const seo: SeoData = {
  title,
  description,
  keywords: [
    "estudio de podcast San Luis Potosí",
    "grabar podcast",
    "estudio de grabación",
    "podcast profesional",
  ],
  canonical,
  alternates: [
    { hreflang: "es", href: canonical },
    { hreflang: "x-default", href: canonical },
  ],
  ogTitle: title,
  ogDescription: description,
  ogImage,
  ogType: "website",
  twitterCard: "summary_large_image",
  twitterSite: "",
  twitterCreator: "",
  jsonLd: {},
}
---

<Base
  locale={locale}
  htmlLang="es"
  chrome={false}
  bodyClass="bg-zima-canvas text-zima-ink"
>
  <Fragment slot="head">
    <Seo {...seo} />
  </Fragment>
  <SectionZimaPodcast locale={locale} />
</Base>
