---
import ConsentScripts from "~/components/layout/ConsentScripts.astro"
import Footer from "~/components/layout/Footer.astro"
import Navigation from "~/components/layout/Navigation.astro"
import JsonLd from "~/components/seo/JsonLd.astro"
import type { Locale } from "~/config/locales"
import {
  organizationLogo,
  organizationName,
  siteDescription,
  siteName,
  siteUrl,
} from "~/lib/site"
import "~/styles/global.css"

interface Props {
  locale: Locale
  htmlLang?: string
  chrome?: boolean
  bodyClass?: string
}

const { locale, htmlLang = locale, chrome = true, bodyClass = "" } = Astro.props

const orgGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      name: organizationName(),
      url: siteUrl(),
      logo: organizationLogo(),
    },
    {
      "@type": "WebSite",
      name: siteName(),
      url: siteUrl(),
      description: siteDescription(),
      publisher: { "@type": "Organization", name: organizationName() },
    },
  ],
}
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <slot name="head" />
    <JsonLd data={orgGraph} />
    <ConsentScripts />
  </head>
  <body class:list={["flex min-h-screen flex-col", bodyClass]}>
    {chrome && <Navigation locale={locale} />}
    <slot />
    {chrome && <Footer locale={locale} />}
  </body>
</html>
